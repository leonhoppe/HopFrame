@using HopFrame.Core.Configuration
@using HopFrame.Web.Components.Components
@using HopFrame.Web.Services
@inherits LayoutComponentBase

<link rel="stylesheet" href="@Assets["_content/HopFrame.Web/hopframe.css"]"/>
<link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
<link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]" defer></script>

<MudThemeProvider IsDarkMode="true" />

<MudLayout>
    <Topbar />
    <Sidebar />
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@inject HopFrameConfig Config
@inject IAuthProvider AuthProvider
@inject NavigationManager Navigator
@implements IDisposable

@code {
    private CancellationTokenSource TokenSource { get; } = new();

    public void Dispose() {
        TokenSource.Dispose();
    }

    protected override async Task OnInitializedAsync() {
        var authorized = await AuthProvider.IsAuthenticated(Config.BaseClaim, TokenSource.Token);
        
        if (!authorized)
            Navigator.NavigateTo(Config.RedirectUnauthorized, true);
    }
}
