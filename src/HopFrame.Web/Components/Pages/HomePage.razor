@page "/admin"
@using HopFrame.Core.Configuration
@using HopFrame.Web.Components.Components
@using HopFrame.Web.Services
@layout HopFrameLayout
@rendermode InteractiveServer

<PageTitle>@Config.CompanyName</PageTitle>

<section style="padding: 1.5rem">
    <MudText Typo="Typo.h5">Pages</MudText>

    <br>
    
    @foreach (var group in GroupedRoutes) {
        @if (!string.IsNullOrWhiteSpace(group.Key)) {
            <MudText Typo="Typo.h6" Style="margin-top: 1rem">@group.Key</MudText>
        }

        <MudStack Wrap="Wrap.Wrap" Row="true">
            @foreach (var route in group) {
                <Card Title="@route.Name"
                      Href="@route.Route"
                      Icon="@route.Icon"
                      Description="@route.Description" />
            }
        </MudStack>
    }
</section>

@inject HopFrameConfig Config
@inject IAuthProvider AuthProvider

@code {

    public static readonly IList<CustomPage> CustomPages = new List<CustomPage>();

    public readonly struct RouteDefinition {
        public required string Route { get; init; }
        public required string Icon { get; init; }
        public required string Name { get; init; }
        public string? Description { get; init; }
        public int OrderIndex { get; init; }
        public string? Category { get; init; }

        public override string ToString() {
            return Name;
        }
    }

    private IEnumerable<IGrouping<string?, RouteDefinition>> GroupedRoutes { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        GroupedRoutes = await GetGroupedRoutes(Config, AuthProvider);
    }

    public static async Task<RouteDefinition[]> GetRoutes(HopFrameConfig config, IAuthProvider authProvider) {
        var pages = CustomPages
            .Select(p => new RouteDefinition {
                Route = p.GetPageRoute(),
                Icon = p.Icon,
                Name = p.Name,
                Description = p.Description,
                OrderIndex = p.OrderIndex,
                Category = p.Category
            })
            .ToList();

        var tables = config.Tables;

        foreach (var table in tables) {
            var authorized = await authProvider.IsAuthenticated(table.ViewClaim, CancellationToken.None);
            if (authorized)
                pages.Add(new RouteDefinition {
                    Route = "admin/" + table.Route,
                    Icon = Icons.Material.Filled.TableChart,
                    Name = table.DisplayName,
                    Description = table.Description,
                    OrderIndex = table.OrderIndex,
                    Category = table.Category
                });
        }

        return pages.OrderBy(p => p.OrderIndex).ToArray();
    }

    public static async Task<IEnumerable<IGrouping<string?, RouteDefinition>>> GetGroupedRoutes(HopFrameConfig config, IAuthProvider authProvider)  {
        var routes = await GetRoutes(config, authProvider);

        IComparer<string?> comparer;
        if (config.CategoryOrder is null || config.CategoryOrder.Length == 0)
            comparer = StringComparer.InvariantCulture;
        else {
            var orderLookup = config.CategoryOrder
                .Select((c, i) => new { Category = c ?? string.Empty, Index = i })
                .ToDictionary(x => x.Category, x => x.Index);

            comparer = Comparer<string?>.Create((a, b) => {
                var aIndex = a is not null && orderLookup.TryGetValue(a, out var ai) ? ai : int.MaxValue;
                var bIndex = b is not null && orderLookup.TryGetValue(b, out var bi) ? bi : int.MaxValue;

                var result = aIndex.CompareTo(bIndex);

                return result != 0 ? result : StringComparer.InvariantCulture.Compare(a, b);
            });
        }

        return routes
            .GroupBy(r => r.Category)
            .OrderBy(g => g.Key, comparer);
    }

}
