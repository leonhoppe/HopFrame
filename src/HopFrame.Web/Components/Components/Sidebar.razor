@using HopFrame.Core.Configuration
@using HopFrame.Web.Components.Pages
@using HopFrame.Web.Services

@rendermode InteractiveServer

<MudDrawer Open="true" Fixed="true" ClipMode="DrawerClipMode.Docked" Width="250px" Style="padding-top: 64px; position: fixed" Height="100dvh">
    <MudNavMenu>
        <MudNavLink Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.SpaceDashboard" Href="admin">Dashboard</MudNavLink>
        
        <br>
        
        @foreach (var group in GroupedRoutes) {
            @if (string.IsNullOrWhiteSpace(group.Key)) {
                @foreach (var route in group) {
                    <MudNavLink Match="NavLinkMatch.All" Icon="@route.Icon" Href="@route.Route" Ripple="false">@route.Name</MudNavLink>
                }
            }
            else {
                <MudNavGroup Title="@group.Key" Expanded="true" Ripple="false" Icon="@(Config.CategoryIcons.TryGetValue(group.Key, out var i) ? i : null)">
                    @foreach (var route in group) {
                        <MudNavLink Match="NavLinkMatch.All" Icon="@route.Icon" Href="@route.Route" Ripple="false">@route.Name</MudNavLink>
                    }
                </MudNavGroup>
            }
        }
    </MudNavMenu>
</MudDrawer>

@inject HopFrameConfig Config
@inject IAuthProvider AuthProvider

@code {

    private IEnumerable<IGrouping<string?, HomePage.RouteDefinition>> GroupedRoutes { get; set; } = null!;

    protected override async Task OnInitializedAsync() {
        GroupedRoutes = await HomePage.GetGroupedRoutes(Config, AuthProvider);
    }

}
