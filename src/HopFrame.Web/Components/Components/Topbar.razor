@using HopFrame.Core.Configuration
@using HopFrame.Web.Components.Pages
@using HopFrame.Web.Services
@rendermode InteractiveServer

<MudPopoverProvider />

<MudAppBar Elevation="0">
    <MudText Typo="Typo.h6">@Config.CompanyName</MudText>
    
    <MudSpacer />
    
    @if (Config.ShowSearchBar) {
        <MudAutocomplete
            T="HomePage.RouteDefinition"
            Placeholder="Search page"
            SearchFunc="@(Search)"
            ValueChanged="@(OnRouteClick)"
            ResetValueOnEmptyText="true"
            SelectValueOnTab="true"
            Dense="true"
            IconSize="Size.Medium"
            @ref="_autocomplete"
            @onfocusin="@(_ => _autocomplete.ResetAsync())"
            AdornmentIcon="@Icons.Material.Filled.Search"/>
    }
    
    <MudSpacer />
    
    <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Color="Color.Inherit" Href="https://git.leon-hoppe.de/leon.hoppe/hopframe" Target="_blank" />
</MudAppBar>

@inject HopFrameConfig Config
@inject NavigationManager Navigator
@inject IAuthProvider AuthProvider

@code {

    private HomePage.RouteDefinition[] Routes { get; set; } = null!;

    private MudAutocomplete<HomePage.RouteDefinition> _autocomplete = null!;

    protected override async Task OnInitializedAsync() {
        Routes = await HomePage.GetRoutes(Config, AuthProvider);
    }

    private Task<IEnumerable<HomePage.RouteDefinition>> Search(string value, CancellationToken _) {
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult(Routes.AsEnumerable());

        var result = Routes
            .Where(r => r.Name.ToLower().Contains(value.ToLower()));

        return Task.FromResult(result);
    }

    private void OnRouteClick(HomePage.RouteDefinition route) {
        // ReSharper disable once ConditionIsAlwaysTrueOrFalseAccordingToNullableAPIContract
        if (route.Route is null)
            return;
        
        Navigator.NavigateTo(route.Route);
    }

}
