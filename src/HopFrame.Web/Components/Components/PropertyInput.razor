@using HopFrame.Core.Configuration

@if (Config.DropdownOptions is not null) {
    @if (Config.PropertyType.HasFlag(PropertyType.Relation)) {
        <MudAutocomplete
            T="RelationResult"
            Value="@(new RelationResult(Value!, _formattedValue!))"
            ValueChanged="@(v => OnValueChanged(v.Value))"
            Label="@Config.DisplayName"
            Clearable="@(Config.PropertyType.HasFlag(PropertyType.Nullable))"
            Disabled="Disabled"
            Variant="Variant"
            Error="@(!string.IsNullOrWhiteSpace(Error))"
            @bind-ErrorText="Error"
            ShowProgressIndicator="true"
            SearchFunc="@(SearchInDropdown)"
            MaxItems="null"/>
    }
    else {
        <MudSelect
            T="object"
            Value="_formattedValue"
            ValueChanged="@(v => OnValueChanged(v))"
            Label="@(Config.DisplayName)"
            Clearable="@(Config.PropertyType.HasFlag(PropertyType.Nullable))"
            Disabled="Disabled"
            Variant="Variant"
            Error="@(!string.IsNullOrWhiteSpace(Error))"
            @bind-ErrorText="Error">
            @foreach (var value in Config.DropdownOptions) {
                <MudSelectItem Value="value">@entityAccessor.FormatValue(value, Config)</MudSelectItem>
            }
        </MudSelect>
    }
}
else if ((Config.PropertyType & PropertyType.Relation) != 0) {
    <MudStack Row="true">
        @if ((Config.PropertyType & PropertyType.List) != 0) {
            <MudField
                Label="@Config.DisplayName"
                Variant="Variant"
                Adornment="Adornment.End"
                AdornmentIcon="@Icons.Material.Filled.OpenInNew"
                OnAdornmentClick="@(OnRelationClick)"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error">
                @foreach (var entry in _formattedListValue.Take(10)) {
                    <MudChip Value="entry"/>
                }

                @if (_formattedListValue.Length > 10) {
                    <MudChip T="string">...</MudChip>
                }
            </MudField>
        }
        else {
            <MudTextField
                T="string"
                Value="_formattedValue"
                Label="@Config.DisplayName"
                ReadOnly="true"
                Variant="Variant"
                Adornment="Adornment.End"
                AdornmentIcon="@Icons.Material.Filled.OpenInNew"
                OnAdornmentClick="@(OnRelationClick)"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
        }

        @if ((Config.PropertyType & PropertyType.Nullable) != 0) {
            <MudIconButton Icon="@Icons.Material.Filled.Clear"/>
        }
    </MudStack>
}
else {
    switch ((PropertyType)((byte)Config.PropertyType & 0x0F)) {
        case PropertyType.Numeric:
            <MudNumericField
                T="double"
                Value="@(Convert.ToDouble(Value))"
                ValueChanged="@(v => OnValueChanged(v))"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;

        case PropertyType.Boolean:
            <MudSwitch
                T="bool"
                Value="@((bool)(Value ?? false))"
                ValueChanged="@(v => OnValueChanged(v))"
                Label="@Config.DisplayName"
                Disabled="Disabled"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;

        case PropertyType.DateTime:
            <MudField Label="@Config.DisplayName"
                      Variant="Variant.Outlined"
                      Style="display: flex"
                      Error="@(!string.IsNullOrWhiteSpace(Error))"
                      @bind-ErrorText="Error">
                <MudStack Row="true">
                    <MudDatePicker
                        Date="_date"
                        DateChanged="@(OnDateChanged)"
                        Label="Date"
                        Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                        Disabled="Disabled"
                        Variant="Variant"/>

                    <MudTimePicker
                        Time="_time"
                        TimeChanged="@(OnTimeChanged)"
                        Label="Time"
                        Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                        Disabled="Disabled"
                        Variant="Variant"/>
                </MudStack>
            </MudField>
            break;

        case PropertyType.DateOnly:
            <MudDatePicker
                Date="_date"
                DateChanged="@(OnDateChanged)"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;

        case PropertyType.TimeOnly:
            <MudTimePicker
                Time="_time"
                TimeChanged="@(OnTimeChanged)"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;

        case PropertyType.Email:
            <MudTextField
                T="string"
                Value="Value?.ToString()"
                ValueChanged="@(v => OnValueChanged(v))"
                InputType="InputType.Email"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;

        case PropertyType.Password:
            <MudTextField
                T="string"
                ValueChanged="@(v => OnValueChanged(v))"
                InputType="@_passwordInputType"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Adornment="Adornment.End"
                AdornmentIcon="@_passwordIcon"
                OnAdornmentClick="@(OnPasswordIconClick)"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;

        case PropertyType.PhoneNumber:
            <MudTextField
                T="string"
                Value="Value?.ToString()"
                ValueChanged="@(v => OnValueChanged(v))"
                InputType="InputType.Telephone"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;

        case PropertyType.Enum:
            <MudSelect
                T="object"
                Value="Value?.ToString()"
                ValueChanged="@(v => OnValueChanged(v))"
                MultiSelection="@((Config.PropertyType & PropertyType.List) != 0)"
                SelectedValuesChanged="@(v => OnValueChanged(v))"
                SelectedValues="_selectedEnums"
                Label="@Config.DisplayName"
                Clearable="@((Config.PropertyType & (PropertyType.Nullable | PropertyType.List)) != 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error">
                @if ((Config.PropertyType & PropertyType.List) != 0) {
                    @foreach (var value in Enum.GetValues(Config.Type.GenericTypeArguments[0])) {
                        <MudSelectItem
                            Value="value">@Enum.GetName(Config.Type.GenericTypeArguments[0], value)</MudSelectItem>
                    }
                }
                else {
                    @foreach (var value in Enum.GetValues(Config.Type)) {
                        <MudSelectItem Value="value">@Enum.GetName(Config.Type, value)</MudSelectItem>
                    }
                }
            </MudSelect>
            break;

        case PropertyType.TextArea:
            <MudTextField
                T="string"
                Value="Value?.ToString()"
                ValueChanged="@(v => OnValueChanged(v))"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"
                Sizing="InputSizing.Auto"
                Lines="Config.SizeRange.Start.Value"
                MaxLines="Config.SizeRange.End.Value"/>
            break;

        default:
            <MudTextField
                T="string"
                Value="Value?.ToString()"
                ValueChanged="@(v => OnValueChanged(v))"
                Label="@Config.DisplayName"
                Required="@((Config.PropertyType & PropertyType.Nullable) == 0)"
                Disabled="Disabled"
                Variant="Variant"
                Error="@(!string.IsNullOrWhiteSpace(Error))"
                @bind-ErrorText="Error"/>
            break;
    }
}