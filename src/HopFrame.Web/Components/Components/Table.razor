@rendermode InteractiveServer

<MudTable ServerData="ReloadTable"
          @ref="Manager"
          T="TableEntry"
          Hover="true"
          Breakpoint="Breakpoint.Sm"
          LoadingProgressColor="Color.Info"
          HorizontalScrollbar="true"
          FixedHeader="true"
          FixedFooter="true"
          CustomHeader="true"
          Elevation="0"
          Height="@(SelectionMode == SelectionMode.None ? "calc(100vh - 180px)" : "70vh")"
          OnRowClick="@(OnRowClick)"
          Class="@(SelectionMode == SelectionMode.None ? "no-cursor" : null)">
    <ToolBarContent>
        <MudText Typo="Typo.h6">@Config.DisplayName</MudText>
        <MudButton OnClick="@(Manager.ReloadServerData)" Style="margin-left: 0.5rem">Reload</MudButton>
        <MudSpacer />
        <MudStack Row="true" Spacing="2" Style="min-width: 600px">
            <MudTextField
                T="string"
                Placeholder="Search"
                Adornment="Adornment.Start"
                AdornmentIcon="@Icons.Material.Filled.Search"
                IconSize="Size.Medium"
                Class="mt-0"
                FullWidth="true"
                Clearable="true"
                DebounceInterval="200"
                OnDebounceIntervalElapsed="@(s => OnSearch(s))" />

            <MudTooltip Text="Advanced Search">
                <MudIconButton
                    Icon="@Icons.Material.Filled.ManageSearch"
                    ButtonType="ButtonType.Button"
                    Size="Size.Small"
                    Style="width: 37px; height: 37px"
                    OnClick="@(() => ShowAdvancedSearch = !ShowAdvancedSearch)" />
            </MudTooltip>

            @if (ShowActionButtons) {
                <MudButton EndIcon="@Icons.Material.Filled.Add"
                           Style="margin-right: 0.5rem"
                           OnClick="@(OnAddClick)">
                    Add
                </MudButton>
            }
        </MudStack>
    </ToolBarContent>
    <HeaderContent>
        <MudTHeadRow>
            @if (SelectionMode != SelectionMode.None) {
                <MudTh>
                    @if (SelectionMode == SelectionMode.Multiple) {
                        <MudIconButton Icon="@Icons.Material.Filled.DeleteForever" OnClick="@(() => SelectedEntries.Clear())" Size="Size.Small" />
                    }
                </MudTh>
            }
        
            @foreach (var prop in OrderedProperties) {
                <MudTh>
                    <MudTableSortLabel
                        T="object"
                        @ref="SortDirections[prop.Identifier]"
                        SortDirectionChanged="@(dir => OnSort(prop, dir))"
                        Enabled="@prop.Sortable">
                        @prop.DisplayName
                    </MudTableSortLabel>
                </MudTh>
            }

            @if (ShowActionButtons) {
                <MudTh>Actions</MudTh>
            }
        </MudTHeadRow>

        @if (ShowAdvancedSearch) {
            <MudTHeadRow>
                @foreach (var prop in OrderedProperties) {
                    <MudTh Style="padding: 0.5rem;">
                        @if (prop.Searchable) {
                            <AdvancedSearchField Property="prop" OnValueChanged="@((value) => OnAdvancedSearch(prop.Identifier, value))" />
                        }
                    </MudTh>
                }

                @if (ShowActionButtons) {
                    <MudTh />
                }
            </MudTHeadRow>
        }
    </HeaderContent>
    <RowTemplate>
        @switch (SelectionMode) {
            case SelectionMode.Single:
                <MudTd Style="padding-block: 0">
                    <MudRadioGroup T="bool" Value="@(IsSelected(context))" ValueChanged="@(() => ToggleSelect(context))">
                        <MudRadio T="bool" Value="true" Dense="true" />
                    </MudRadioGroup>
                </MudTd>
                break;
                
            case SelectionMode.Multiple:
                <MudTd>
                    <MudCheckBox T="bool" Value="@(IsSelected(context))" ValueChanged="@(() => ToggleSelect(context))" />
                </MudTd>
                break;
        }
        
        @foreach (var prop in OrderedProperties) {
            <MudTd DataLabel="@prop.DisplayName" Style="text-overflow: ellipsis; white-space: nowrap; overflow: hidden; max-width: 500px">@context.Columns[prop.Identifier]</MudTd>
        }
        
        @if (ShowActionButtons) {
            <MudTd DataLabel="Actions">
                <MudStack Row="true" Spacing="1">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(async () => await OnEditClick(context.Entry))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(async () => await OnDeleteClick(context.Entry))" />
                </MudStack>
            </MudTd>
        }
    </RowTemplate>
    <PagerContent>
        <MudTablePager />
    </PagerContent>
</MudTable>